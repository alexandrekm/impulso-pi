chmod +x .githooks/pre-commit

existing_hooks_path="$(git config --local --get core.hooksPath || true)"
if [[ -z "$existing_hooks_path" || "$existing_hooks_path" == ".githooks" ]]; then
  git config --local core.hooksPath .githooks
else
  echo "warning: core.hooksPath already set to '$existing_hooks_path'; not overwriting" >&2
fi
