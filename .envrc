chmod +x .githooks/pre-commit

existing_hooks_path="$(git config --local --get core.hooksPath || true)"
if [[ -z "$existing_hooks_path" || "$existing_hooks_path" == ".githooks" ]]; then
  git config --local core.hooksPath .githooks
else
  echo "warning: core.hooksPath already set to '$existing_hooks_path'; not overwriting" >&2
fi

# Link shared gitignored dirs (e.g. reference-impl/) from the main worktree into
# this worktree. Idempotent and silent on success; run on every direnv entry.
if command -v node >/dev/null 2>&1; then
  node "$PWD/scripts/link-shared.mjs" || true
fi
