#!/bin/sh
# impulso-payload-browser — wrapper to launch the payload-browser TUI.
# Installed by impulso-pi install.sh to ~/.local/bin/impulso-payload-browser.
#
# Resolves the repo's scripts/payload-browser.mjs (located relative to this
# wrapper's source in the repo at install time) and runs it with node, passing
# through any arguments. Falls back to a PATH-based `node` so it works
# regardless of the user's node setup.

# The absolute path to the repo dir is baked in at install time by
# scripts/install.mjs (deployPayloadBrowser). If this script was copied
# directly without that step, REPO_DIR is empty and we try to locate it via
# common checkout locations.
REPO_DIR="__IMPULSO_PI_REPO_DIR__"

if [ -z "$REPO_DIR" ] || [ "$REPO_DIR" = "__IMPULSO_PI_REPO_DIR__" ]; then
  # Best-effort fallback: search a few likely locations.
  for cand in \
    "$HOME/orca/workspaces/impulso-pi/lookdown" \
    "$HOME/code/impulso-pi" \
    "$HOME/src/impulso-pi"; do
    if [ -f "$cand/scripts/payload-browser.mjs" ]; then
      REPO_DIR="$cand"
      break
    fi
  done
fi

SCRIPT="$REPO_DIR/scripts/payload-browser.mjs"
if [ ! -f "$SCRIPT" ]; then
  echo "impulso-payload-browser: cannot find scripts/payload-browser.mjs" >&2
  echo "(looked under REPO_DIR=$REPO_DIR). Re-run impulso-pi install.sh to fix the path." >&2
  exit 1
fi

exec node "$SCRIPT" "$@"
