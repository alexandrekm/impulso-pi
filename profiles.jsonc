{
  // Install rule: a resource lands on a profile if it has "core" OR any tag
  // in the profile's "tags". "core" is implicit on every profile — never
  // list it in a profile's "tags". "base" is a pseudo-tag no profile
  // declares: resources tagged only "base" land ONLY on the --base target
  // (the raw ~/.pi/agent dir), used for machine-global files.
  "tags": ["core", "work", "personal", "base"],

  // Settings merged into every target's settings.json on install (all
  // profiles and --base). Only the declared keys are touched; everything
  // else (including packages[]) is left alone.
  "settings": {
    "hideThinkingBlock": true,
    // Catppuccin Mocha, from the pi-themes package (git: below).
    "theme": "catppuccin-mocha",
  },

  "profiles": {
    "work": { "tags": ["work"] },
    "personal": { "tags": ["personal"] },
  },

  "resources": {
    // "core" baseline = everything currently in this repo. Always installed
    // (every profile, and --base).
    "npm:@juicesharp/rpiv-ask-user-question": { "tags": ["core"] },
    "npm:@alfonzjanfrithz/pi-websearch": { "tags": ["core"] },

    // Notify the active pi config dir at startup (which profile loaded).
    "extensions/startup/print-config-dir.ts": { "tags": ["core"] },

    // FFF (dmtrKovalenko/fff): Rust-native, SIMD-accelerated file finder
    // that replaces pi's built-in `find`/`grep` (which spawn `fd`/`rg` per
    // call) with an in-process, frecency-ranked, git-aware search. Core so
    // every profile gets it. Runs in `override` mode (replaces the built-in
    // tools instead of adding a second fffind/ffgrep pair) and with home-dir
    // indexing disabled — both pinned by extensions/fff/fff-env.ts, which
    // sets PI_FFF_MODE=override and FFF_ENABLE_HOME_SCAN=0 at import time
    // before @ff-labs/pi-fff's factory reads them (local extensions load
    // before npm-package extensions). Override mode means the tool names
    // stay `find`/`grep`/`multi_grep`, so no prompt changes are needed.
    // https://github.com/dmtrKovalenko/fff
    "npm:@ff-labs/pi-fff": { "tags": ["core"] },
    "extensions/fff/fff-env.ts": { "tags": ["core"] },

    // pi-themes (sting8k): companion themes for pi, incl. catppuccin-mocha
    // (pinned as the shared "theme" in the settings object above). Core so
    // every profile gets it. Git-only (not on npm), so it uses the git:
    // resource kind. https://github.com/sting8k/pi-themes
    "git:github.com/sting8k/pi-themes": { "tags": ["core"] },

    // @juanbenjumea/pi-dynamic-footer: dynamic footer with live observability
    // — context gauge + %, live/last-turn TPS, per-turn ↑input/↓output
    // tokens, session cost, cache hit %, git branch + ±diff lines, thinking
    // level, fast-mode indicator, turn count, and rolling-window subscription
    // quota bars for 8 provider types (Claude/Codex/OpenCode Go/ClinePass/
    // Umans/Copilot/Gemini/Kimi). Replaces pi's default footer entirely via
    // ctx.ui.setFooter(). Commands: /obs (dashboard + last 10 sessions),
    // /obs-toggle, /obs-settings (segment toggles, context zones, presets).
    // Persists last 10 session summaries under ~/.pi/agent/observability/.
    //
    // Replaced pi-droid-styling as the footer owner: droid-styling baked its
    // footer into the BoxEditor editor component with no "disable footer"
    // config flag (userZoneStyle only offers droid/gemini/cli-dock, all render
    // a footer), so the two couldn't coexist on the single setFooter slot.
    // droid-styling's editor dock / tool tags / startup header are dropped in
    // favor of pi's native editor + this footer. footer-status-widgets.ts was
    // removed too: its toks/cost/cache widgets duplicated this footer's, and
    // its only unique signal (gh pr view PR status) is not worth the overlap.
    // pi-themes is kept so catppuccin-mocha stays. Quota bars read credentials
    // from ~/.pi/agent/auth.json (populated by /login) — inert without them.
    // https://www.npmjs.com/package/@juanbenjumea/pi-dynamic-footer
    "npm:@juanbenjumea/pi-dynamic-footer": { "tags": ["core"] },

    // dynamic-footer-theme: local companion that re-themes pi-dynamic-footer's
    // segment renderers with emoji icons (🤖 ⏱ 📁 🌿 📊 ⚡ ⬆ ⬇ 🗃 💰) and the
    // old pi-droid-styling / footer-status-widgets color accents. Monkey-patches
    // the installed package's `builtinRenderers` in place (local extensions load
    // before npm ones; jiti's module cache is keyed by resolved path, so the
    // absolute-path import yields the same module instance the package uses).
    // Only swaps segment content — layout/separator stay upstream. No-op if the
    // package isn't installed. Currently being iterated on from the personal
    // profile; once the styling settles it stays core (both profiles). See
    // extensions/dynamic-footer-theme/dynamic-footer-theme.ts.
    "extensions/dynamic-footer-theme/dynamic-footer-theme.ts": { "tags": ["core"] },

    // Save every LLM provider request payload to <configDir>/payloads/ for
    // inspecting system prompts, messages, tool definitions, etc. Defaults
    // to off; the on/off choice persists per profile. Control with
    // `/payload-exporter on|off|toggle|status`. <configDir> is the active
    // profile dir (ppi) or ~/.pi/agent for --base.
    "extensions/payload-exporter/payload-exporter.ts": { "tags": ["core"] },

    // Vision handoff for text-only models (https://pi.dev/packages/pi-vision-handoff).
    // Transparent swap: describes images via a chosen vision model and swaps
    // the image block for text before the request leaves — no tool, no extra
    // turn. Pick a describer once with `/vision-handoff`; auto-applies to all
    // non-vision models. Chosen over @getpipher/vision for less context + bloat.
    "npm:pi-vision-handoff": { "tags": ["core"] },

    // command-guard: default-allow bash policy (ask/deny globs). Engine +
    // index land as a directory extension; config is per-profile. On --base
    // both configs are selected and config.personal.json wins (alphabetical
    // tie-break, flagged as shadowed).
    "extensions/command-guard/command-guard.ts": {
      "tags": ["core"],
      "dest": "extensions/command-guard/index.ts",
    },
    "extensions/command-guard/engine.ts": {
      "tags": ["core"],
      "dest": "extensions/command-guard/engine.ts",
    },
    "extensions/command-guard/config.work.json": {
      "tags": ["work"],
      "dest": "extensions/command-guard/command-guard.json",
    },
    "extensions/command-guard/config.personal.json": {
      "tags": ["personal"],
      "dest": "extensions/command-guard/command-guard.json",
    },

    // Cursor models (Claude/GPT/Gemini/Grok/Composer) as a pi provider via
    // @rahularya01/pi-cursor. OAuth login (/login cursor), live GetUsableModels
    // discovery, native Connect/protobuf streaming over HTTP/2, and a tool
    // bridge that maps Cursor tool calls onto pi's own tool loop (pi executes
    // the tools with its permission system; the provider parks the HTTP/2
    // bridge and resumes it on the next turn). Then /model cursor/<id>.
    //
    // The env-setter extension below pins two wire values Cursor now requires
    // (client version + chat endpoint) to the fresher values oh-my-pi uses;
    // upstream's defaults are stale and Cursor rejects them. Override either
    // with PI_CURSOR_CLIENT_VERSION / PI_CURSOR_AGENT_URL if Cursor moves again.
    "npm:@rahularya01/pi-cursor": { "tags": ["core"] },
    "extensions/cursor/cursor-env.ts": { "tags": ["core"] },

    // pi-hashline-edit (RimuruW): hash-anchored `read`/`edit` override.
    // Every line gets a `LINE#HASH:` prefix and edits target those anchors,
    // so edits never land on the wrong line after a concurrent write or a
    // stale read. `read` is replaced wholesale; `edit` gains `replace`/
    // `append`/`prepend`/`replace_text` ops validated against content hashes
    // (multiple ops per call, applied bottom-up), with 3-way snapshot merge
    // recovery on stale anchors. Inspired by oh-my-pi's hashline.
    //
    // Chosen over the YuGiMob `pi-hashline-edit-pro` fork: the fork's config
    // path is hardcoded to XDG (~/.config/...), which would fight the
    // profile machinery (the way pi-droid-styling's hardcoded config path
    // did); this original reads its
    // config via pi's `getAgentDir()` (see extensions/hashline/hashline.json
    // below), so it lands per-profile. It also keeps the `edits[]` array
    // (multi-op per call) and the opt-in `grep` override, which the fork
    // drops to one `replace` per call.
    //
    // Config (`hashline.json` at the profile root) pins `grep: false` because
    // @ff-labs/pi-fff already overrides `find`/`grep` in `override` mode —
    // both extensions registering a `grep` tool would collide. Leave grep
    // off and let FFF own search; the anchors FFF returns are plain line
    // numbers, so re-`read` before editing a grep hit. Tune hashLength
    // (2–4) / replaceText there if desired.
    // https://github.com/RimuruW/pi-hashline-edit
    "npm:pi-hashline-edit": { "tags": ["core"] },
    "extensions/hashline/hashline.json": {
      "tags": ["core"],
      "dest": "hashline.json",
    },

    // search_docs: query the team's internal docs Knowledge Base (AWS
    // Bedrock) via the API Gateway proxy before falling back to the web.
    // Gateway mode only — needs KB_GATEWAY_URL + KB_GATEWAY_KEY. If the KB
    // has nothing, the tool tells the agent to use the `websearch` tool.
    // Work-only: the KB holds internal/work documentation.
    "extensions/search_docs/search_docs.ts": { "tags": ["work"] },

    // pi-cache-graph (championswimmer): observability for provider prompt/KV
    // caches. Adds /cache, /cache graph, /cache stats, /cache export commands
    // — a TUI overlay with per-turn / cumulative hit-rate views and CSV export.
    // Pure measurement, no prompt mutation. Pair with any cache optimizer to
    // verify it actually helps in your workload. Core so every profile gets it.
    // https://pi.dev/packages/pi-cache-graph
    "npm:pi-cache-graph": { "tags": ["core"] },

    // Orca Dev integration: Orca hardcodes ~/.pi/agent for its managed pi
    // extensions (it sets ORCA_PI_SOURCE_AGENT_DIR unconditionally), so under
    // ppi profiles they land in the wrong dir and are never loaded (pi only
    // reads PI_CODING_AGENT_DIR, i.e. the active profile). Vendored here so
    // install.sh puts them where pi actually looks. Orca overwrites its own
    // copies in ~/.pi/agent/extensions on integration updates — re-copy those
    // into this repo (`extensions/orca-integration/`, `extensions/herdr/`) and
    // re-run install.sh when Orca bumps them; check HERDR_INTEGRATION_VERSION
    // / the `@orca-managed-pi-extension` header for drift. Core so every
    // profile gets Orca's dashboard status/prefill/title features.
    //   - orca-agent-status.ts: posts session/tool/message lifecycle events
    //     to Orca's local hook server (dashboard status, active tool, last
    //     message preview).
    //   - orca-prefill.ts: pre-fills the editor from ORCA_PI_PREFILL on
    //     startup (Orca "send prompt" suggestions).
    //   - orca-titlebar-spinner.ts: animates the terminal title while the
    //     agent is working.
    //   - herdr/herdr-agent-state.ts: reports working/blocked/idle state to
    //     herdr (Orca's pane orchestration layer) over a unix socket, for
    //     the per-pane status indicator. Installed/versioned by herdr
    //     independently of the orca-* files above (HERDR_INTEGRATION_VERSION).
    // All four are no-ops unless the corresponding ORCA_*/HERDR_* env vars
    // are set, so they're inert outside an Orca-launched terminal.
    "extensions/orca-integration/orca-agent-status.ts": { "tags": ["core"] },
    "extensions/orca-integration/orca-prefill.ts": { "tags": ["core"] },
    "extensions/orca-integration/orca-titlebar-spinner.ts": { "tags": ["core"] },
    "extensions/herdr/herdr-agent-state.ts": { "tags": ["core"] },

    // address-pr-comments: one-pass workflow to fetch, evaluate, and act on
    // every PR review comment (Copilot/bots + human) — assess each, batch-apply
    // approved fixes, commit (Conventional Commits + Jira scope), reply to and
    // resolve every thread, then report. disable-model-invocation: true in the
    // frontmatter hides it from the system prompt, so the agent never loads it
    // on its own — invoke explicitly with /skill:address-pr-comments. Core so
    // every profile gets it. Ported from impulso-omp's skill of the same name;
    // the OMP `ask` tool calls were adapted to pi's `ask_user_question` schema.
    "skills/address-pr-comments/": { "tags": ["core"] },

    // pi-provider-litellm (balcsida): LiteLLM proxy native Provider extension.
    // Discovers models from a self-hosted LiteLLM proxy and registers them
    // under pi providers (default provider name `litellm`; aliases possible
    // via `litellm.providers` in settings.json). Supports `/login litellm`
    // (incl. enterprise SSO and Google ADC token auth), LiteLLM MCP tool
    // discovery, and LiteLLM Skills Gateway prompt injection. Core so every
    // profile gets it; configure via `/login litellm` or LITELLM_BASE_URL /
    // LITELLM_API_KEY env vars. https://pi.dev/packages/pi-provider-litellm
    "npm:pi-provider-litellm": { "tags": ["core"] },

    // jira: resolve/find/create/manage Jira tickets via `acli` (with REST
    // fallbacks in FALLBACK.md and a full command reference in REFERENCE.md).
    // jira-authoring: create well-structured tickets under existing epics
    // with AICPE templates — loaded by jira's ticket-creation step. Ported
    // from impulso-omp's mtv-jira / mtv-jira-authoring skills, renamed
    // without the mtv- prefix (not work-exclusive by nature, just tagged
    // work here since Jira/acli are Motive-specific tools).
    "skills/jira/": { "tags": ["work"] },
    "skills/jira-authoring/": { "tags": ["work"] },

    // create-pr: commit + PR workflow enforcing Motive's commitlint rules
    // (Conventional Commits, uppercase Jira-key scope, 200-char lengths,
    // no-special-chars subject) verified against folder-inference repos'
    // commitlint.config.js, plus branch naming and Jira ticket linkage via
    // the jira skill. disable-model-invocation: true hides it from the
    // system prompt — invoke explicitly with /skill:create-pr. Ported from
    // impulso-omp's mtv-commit-and-pr skill, renamed to drop the mtv-
    // prefix and made command-only like address-pr-comments.
    "skills/create-pr/": { "tags": ["work"] },

    // Future tagged resources, e.g.:
    // "skills/home-lab/": { "tags": ["personal"] },
    // "npm:@pi-stef/atlassian": { "tags": ["work"] }
  },

  // Standalone global CLI tools (NOT pi resources). These are regular npm
  // packages that live in this repo and are installed globally (npm i -g) by
  // ./install.sh, separate from the profile resource sync above. They are not
  // synced into any profile dir and are not loaded by pi. `path` is relative
  // to the repo root; `bin` is informational (read from package.json).
  "tools": {
    "pi-omp-stats": { "path": "packages/pi-omp-stats" },
  },
}
