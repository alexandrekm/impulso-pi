{
  // Install rule: a resource lands on a profile if it has "core" OR any tag
  // in the profile's "tags". "core" is implicit on every profile — never
  // list it in a profile's "tags". "base" is a pseudo-tag no profile
  // declares: resources tagged only "base" land ONLY on the --base target
  // (the raw ~/.pi/agent dir), used for machine-global files.
  "tags": ["core", "work", "personal", "base"],

  // MANAGED settings — merged into every target's settings.json on install
  // (all profiles and --base) and OVERWRITTEN on every sync. The repo owns
  // these keys. Only the declared keys are touched; everything else
  // (including packages[]) is left alone.
  "settings": {
    "hideThinkingBlock": true,
    // Catppuccin Mocha, from the pi-themes package (git: below).
    "theme": "catppuccin-mocha",

    // Default model — repo-owned, re-applied on every sync. In-session
    // model changes (picker, /model <name>, Ctrl+P) stay session-only in
    // pi 0.84.4 and never rewrite this. Change the default by editing
    // these two lines + `./install.sh`.
    "defaultProvider": "openrouter",
    "defaultModel": "z-ai/glm-5.3",

    // Ctrl+P model-cycle shortlist (--models format: exact ids or globs,
    // optional :thinking suffix; matched against provider/id or bare id).
    // Order = cycle order. Repo-owned like the keys above: edit +
    // `./install.sh` to change. :batch variants are separate ids and are
    // not matched by the exact forms below.
    "enabledModels": ["moonshotai/kimi-k3", "anthropic/claude-sonnet-5", "anthropic/claude-opus-5"],
  },

  // DEFAULT settings — deep fill-only: a key (and nested sub-keys) is
  // written ONLY when absent in settings.json, so user overrides made via
  // /settings survive sync. Use this to seed safe initial values for
  // extension-managed namespaces on fresh machines without clobbering
  // per-user tuning. Keys removed here are left as-is (non-clobber).
  "settingsDefaults": {
    // pi-observational-memory: by default the proactive compaction trigger
    // fires at a fixed 81k-token threshold (calibrated mode), which compacts
    // far too often on large-context models. Ratio mode + 0.9 makes it fire
    // at ~90% of the active model's context window instead, so the auto-
    // trigger rarely fires while observation/reflection work continues; pi's
    // native window-pressure compaction remains the safety net. The
    // /settings "Compaction trigger mode" toggle can still flip this back
    // to `calibrated` — install only fills these when absent, never resets.
    "observational-memory": {
      "compactAfterTokensMode": "ratio",
      "compactAfterTokensRatio": 0.6,
    },

    // pi-subagents: seeded here (fill-only) instead of managed `settings` so
    // each profile can pick its own scout model locally in settings.json
    // without the next install reverting it (managed keys overwrite
    // whole-key; defaults never reset existing values). Fresh machines get
    // the same starting point: builtin agent roles disabled (custom
    // read-only scout only) and a fast recon tier on scout. agentOverrides
    // beats agent frontmatter, so agents/scout.md stays vendor-neutral.
    // Trade-off: disableBuiltins is seed-only — it is no longer re-applied
    // if you flip it off yourself.
    "subagents": {
      "disableBuiltins": true,
      "agentOverrides": {
        "scout": {
          "model": "google/gemini-3.8-flash",
          "thinking": "low",
        },
      },
    },
  },

  "profiles": {
    "work": { "tags": ["work"] },
    "personal": { "tags": ["personal"] },
  },

  "resources": {
    // "core" baseline = everything currently in this repo. Always installed
    // (every profile, and --base).
    "npm:@juicesharp/rpiv-ask-user-question": { "tags": ["core"] },
    "npm:@alfonzjanfrithz/pi-websearch": { "tags": ["core"] },

    // pi-subagents owns all child-process lifecycle. The exact release was
    // preflighted against Pi 0.84.4: scout uses a strict read/search tool
    // allowlist, starts fresh, and Orca is only a best-effort observer.
    "npm:pi-subagents@0.64.0": { "tags": ["core"] },
    "extensions/subagent-telemetry/subagent-telemetry.ts": {
      "tags": ["core"],
      "dest": "extensions/subagent-telemetry/index.ts",
    },
    "extensions/subagent-telemetry/config.json": {
      "tags": ["core"],
      "dest": "extensions/subagent/config.json",
    },
    "agents/scout.md": { "tags": ["core"], "dest": "agents/scout.md" },

    // Notify the active pi config dir at startup (which profile loaded).
    "extensions/startup/print-config-dir.ts": { "tags": ["core"] },

    // system-prompt: owns the FIXED parts of pi's system prompt (intro,
    // tools-footer line, always-on guidelines) while keeping the DYNAMIC parts
    // (active tools, tool-contributed guidelines, --append-system-prompt,
    // <project_context>, skills, cwd) flowing from pi. It replaces pi's verbose
    // always-on Pi-documentation block with a short pointer to the on-demand
    // pi-development skill, keeping the full instructions out of each prompt.
    // Respects user overrides (SYSTEM.md / --system-prompt): if customPrompt is
    // set, it leaves pi's prompt alone. Toggled via /settings id `system-prompt`.
    // Core so every profile gets it.
    "extensions/system-prompt/system-prompt.ts": { "tags": ["core"] },

    // /impulso AND /settings — impulso-pi feature settings page. An OMP-
    // style tabbed TUI (built on @earendil-works/pi-tui) listing every
    // feature declared in extensions/impulso-settings/features.ts grouped
    // into tabs/sections, toggling them: npm/git packages via settings.json
    // packages[] autoload, local extensions via the <configDir>/impulso-
    // settings.json manifest (each local extension guards its factory with
    // isFeatureEnabled() from feature-flag.ts), and a safe subset of pi
    // built-in settings via settings.json keys. Changes persist
    // immediately; the footer hints /reload to apply. Add a Feature entry
    // in features.ts and it shows up here automatically.
    //
    // `/settings` override: pi hardcodes /settings → its native menu in the
    // editor's onSubmit (before extension commands parse), and exposes no
    // API to open that menu. So editor.ts installs a CustomEditor (via
    // ctx.ui.setEditorComponent at session_start) whose onSubmit wrapper
    // intercepts: bare `/settings` opens the impulso page; `/settings pi`
    // (or `/pi-settings`) falls through to pi's original onSubmit, opening
    // pi's native menu. `/impulso` also works. Trade-off: the custom editor
    // owns the editor factory session-wide. Core so every profile gets it.
    "extensions/impulso-settings/": { "tags": ["core"] },

    // FFF (dmtrKovalenko/fff): Rust-native, SIMD-accelerated file finder
    // that replaces pi's built-in `find`/`grep` (which spawn `fd`/`rg` per
    // call) with an in-process, frecency-ranked, git-aware search. Core so
    // every profile gets it. Runs in `override` mode (replaces the built-in
    // tools instead of adding a second fffind/ffgrep pair) and with home-dir
    // indexing disabled — both pinned by extensions/fff/fff-env.ts, which
    // sets PI_FFF_MODE=override and FFF_ENABLE_HOME_SCAN=0 at import time
    // before @ff-labs/pi-fff's factory reads them (local extensions load
    // before npm-package extensions). Override mode means the tool names
    // stay `find`/`grep`/`multi_grep`, so no prompt changes are needed.
    // https://github.com/dmtrKovalenko/fff
    "npm:@ff-labs/pi-fff": { "tags": ["core"] },
    "extensions/fff/fff-env.ts": { "tags": ["core"] },

    // pi-themes (sting8k): companion themes for pi, incl. catppuccin-mocha
    // (pinned as the shared "theme" in the settings object above). Core so
    // every profile gets it. Git-only (not on npm), so it uses the git:
    // resource kind. https://github.com/sting8k/pi-themes
    "git:github.com/sting8k/pi-themes": { "tags": ["core"] },

    // pi-dynamic-footer (vendored from @juanbenjumea/pi-dynamic-footer v0.1.7
    // by Juan Benjumea): dynamic footer with live observability — context
    // gauge + %, live/last-turn TPS, per-turn ↑input/↓output tokens, session
    // cost, cache hit %, git branch + ±diff lines, thinking level, fast-mode
    // indicator, turn count, and rolling-window subscription quota bars for 8
    // provider types (Claude/Codex/OpenCode Go/ClinePass/Umans/Copilot/
    // Gemini/Kimi). Owns the footer via ctx.ui.setFooter(). Commands: /obs
    // (dashboard + last 10 sessions), /obs-toggle, /obs-settings (segment
    // toggles, context zones, presets). Persists last 10 session summaries
    // under ~/.pi/agent/observability/.
    //
    // Vendored (not `npm:`) so we can edit the segment renderers + layout
    // directly for the emoji-icon / old-footer color theme — the npm package
    // ships fixed styling and pi's jiti loader isolates the module cache, so a
    // runtime monkey-patch can't reach the package's `builtinRenderers` (and
    // Node refuses to strip types under node_modules, blocking native import).
    // Trade-off: no upstream auto-updates — re-sync from the package manually
    // (bump the vendored tree + re-apply theme edits in
    // lib/footer-engine/segments.ts and layout.ts). Its @juanbenjumea/
    // opencode-go-usage dep is vendored under vendor/opencode-go-usage/ with
    // imports rewritten to relative paths; the rest is relative or
    // @earendil-works/* (resolved by pi's jiti aliases). Core so every profile
    // gets it. Replaced pi-droid-styling (which baked its footer into BoxEditor
    // with no disable flag) and footer-status-widgets (duplicate metrics).
    // Quota bars read credentials from ~/.pi/agent/auth.json (populated by
    // /login) — inert without them.
    // https://www.npmjs.com/package/@juanbenjumea/pi-dynamic-footer
    "extensions/pi-dynamic-footer/": { "tags": ["core"] },

    // Save every LLM provider request payload to <configDir>/payloads/ for
    // inspecting system prompts, messages, tool definitions, etc. Defaults
    // to off; the on/off choice persists per profile. Control with
    // `/payload-exporter on|off|toggle|status`. <configDir> is the active
    // profile dir (ppi) or ~/.pi/agent for --base.
    "extensions/payload-exporter/payload-exporter.ts": { "tags": ["core"] },

    // Google Workspace CLI skills (docs, sheets, drive, gmail + shared +
    // granular helper sub-skills) vendored from
    // https://github.com/googleworkspace/cli under extensions/gws/skills/.
    // Injected in doc mode: the extension reads <configDir>/mode.json and
    // surfaces Docs/Sheets/Drive/Gmail skills when mode === "doc". No
    // separate /gws command or settings toggle — `/mode doc` (from the
    // modes extension) is the gws switch. Inert on profiles without modes.
    // Core so the vendored skills ship everywhere; the trigger is work-only.
    "extensions/gws/": { "tags": ["core"] },

    // On-demand skill injection (keyword-triggered). Keeps skills out of
    // the always-on system prompt (via `disable-model-invocation: true` in
    // their SKILL.md) and instead appends a tiny pointer to the user's own
    // message — not the system prompt — when it matches configured keywords,
    // so the model reads it as part of the user's turn. Config:
    // extensions/on-demand-skills/config.json. Triggers datadog on
    // `datadog`/`dashboard`/`metrics`/etc. Toggled in /settings → Pi → Input.
    // Generic — add more skills to the config anytime.
    "extensions/on-demand-skills/": { "tags": ["core"] },
    // modes: per-profile skill mode switch (code | doc) layered on top of
    // profiles. A mode gates which synced skills reach the system prompt each
    // turn — e.g. code mode shows jira/commit and hides
    // gws-docs-authoring; doc mode shows gws-docs-authoring and hides the
    // PR/commit skills. Skills not in the gated map (datadog, glean) stay
    // always-on. Command-only flows like /create-pr and
    // /address-pr-comments are prompt templates, unaffected by modes.
    // Toggled with /mode code|doc|toggle;
    // state in <configDir>/mode.json, applies next message (no /reload).
    // Doc mode also surfaces the gws skills (the gws extension reads mode.json).
    // Work-only for now. Config: extensions/modes/config.json. Toggled in
    // /settings → Tools & Safety → Modes.
    "extensions/modes/": { "tags": ["work"] },

    // Vision handoff for text-only models (https://pi.dev/packages/pi-vision-handoff).
    // Transparent swap: describes images via a chosen vision model and swaps
    // the image block for text before the request leaves — no tool, no extra
    // turn. Pick a describer once with `/vision-handoff`; auto-applies to all
    // non-vision models. Chosen over @getpipher/vision for less context + bloat.
    "npm:pi-vision-handoff": { "tags": ["core"] },

    // command-guard: default-allow bash policy (ask/deny globs). Engine +
    // index land as a directory extension; config is per-profile. On --base
    // both configs are selected and config.personal.json wins (alphabetical
    // tie-break, flagged as shadowed).
    "extensions/command-guard/command-guard.ts": {
      "tags": ["core"],
      "dest": "extensions/command-guard/index.ts",
    },
    "extensions/command-guard/engine.ts": {
      "tags": ["core"],
      "dest": "extensions/command-guard/engine.ts",
    },
    "extensions/command-guard/config.work.json": {
      "tags": ["work"],
      "dest": "extensions/command-guard/command-guard.json",
    },
    "extensions/command-guard/config.personal.json": {
      "tags": ["personal"],
      "dest": "extensions/command-guard/command-guard.json",
    },

    // commit-guard: enforces commitlint on every `git commit` the agent
    // makes (work-only). Hooks the bash tool_call, parses the commit
    // message, blocks --no-verify, and validates the message — running
    // the repo's own commitlint when present (matching CI) or the built-in
    // Motive rules otherwise. Mirrors command-guard's interception pattern;
    // reuses command-guard/engine.ts (core, always present) for shell
    // peeling/splitting. See extensions/commit-guard/README.md.
    "extensions/commit-guard/commit-guard.ts": {
      "tags": ["work"],
      "dest": "extensions/commit-guard/index.ts",
    },
    "extensions/commit-guard/parse.ts": {
      "tags": ["work"],
      "dest": "extensions/commit-guard/parse.ts",
    },
    "extensions/commit-guard/rules.ts": {
      "tags": ["work"],
      "dest": "extensions/commit-guard/rules.ts",
    },

    // Cursor models (Claude/GPT/Gemini/Grok/Composer) as a pi provider via
    // @rahularya01/pi-cursor. OAuth login (/login cursor), live GetUsableModels
    // discovery, native Connect/protobuf streaming over HTTP/2, and a tool
    // bridge that maps Cursor tool calls onto pi's own tool loop (pi executes
    // the tools with its permission system; the provider parks the HTTP/2
    // bridge and resumes it on the next turn). Then /model cursor/<id>.
    //
    // The env-setter extension below pins two wire values Cursor now requires
    // (client version + chat endpoint) to the fresher values oh-my-pi uses;
    // upstream's defaults are stale and Cursor rejects them. Override either
    // with PI_CURSOR_CLIENT_VERSION / PI_CURSOR_AGENT_URL if Cursor moves again.
    "npm:@rahularya01/pi-cursor": { "tags": ["core"] },
    "extensions/cursor/cursor-env.ts": { "tags": ["core"] },

    // pi-hashline-edit (RimuruW): hash-anchored `read`/`edit` override.
    // Every line gets a `LINE#HASH:` prefix and edits target those anchors,
    // so edits never land on the wrong line after a concurrent write or a
    // stale read. `read` is replaced wholesale; `edit` gains `replace`/
    // `append`/`prepend`/`replace_text` ops validated against content hashes
    // (multiple ops per call, applied bottom-up), with 3-way snapshot merge
    // recovery on stale anchors. Inspired by oh-my-pi's hashline.
    //
    // Chosen over the YuGiMob `pi-hashline-edit-pro` fork: the fork's config
    // path is hardcoded to XDG (~/.config/...), which would fight the
    // profile machinery (the way pi-droid-styling's hardcoded config path
    // did); this original reads its
    // config via pi's `getAgentDir()` (see extensions/hashline/hashline.json
    // below), so it lands per-profile. It also keeps the `edits[]` array
    // (multi-op per call) and the opt-in `grep` override, which the fork
    // drops to one `replace` per call.
    //
    // Config (`hashline.json` at the profile root) pins `grep: false` because
    // @ff-labs/pi-fff already overrides `find`/`grep` in `override` mode —
    // both extensions registering a `grep` tool would collide. Leave grep
    // off and let FFF own search; the anchors FFF returns are plain line
    // numbers, so re-`read` before editing a grep hit. Tune hashLength
    // (2–4) / replaceText there if desired.
    // https://github.com/RimuruW/pi-hashline-edit
    "npm:pi-hashline-edit": { "tags": ["core"] },
    "extensions/hashline/hashline.json": {
      "tags": ["core"],
      "dest": "hashline.json",
    },

    // search_docs: query the team's internal docs Knowledge Base (AWS
    // Bedrock) via the API Gateway proxy before falling back to the web.
    // Gateway mode only — needs KB_GATEWAY_URL + KB_GATEWAY_KEY. If the KB
    // has nothing, the tool tells the agent to use the `websearch` tool.
    // Work-only: the KB holds internal/work documentation.
    "extensions/search_docs/search_docs.ts": { "tags": ["work"] },

    // pi-cache-graph (championswimmer): observability for provider prompt/KV
    // caches. Adds /cache, /cache graph, /cache stats, /cache export commands
    // — a TUI overlay with per-turn / cumulative hit-rate views and CSV export.
    // Pure measurement, no prompt mutation. Pair with any cache optimizer to
    // verify it actually helps in your workload. Core so every profile gets it.
    // https://pi.dev/packages/pi-cache-graph
    "npm:pi-cache-graph": { "tags": ["core"] },
    // pi-observational-memory (elpapi42): keeps long sessions coherent across
    // compactions by capturing observations + distilling reflections in the
    // background as you work, so compaction becomes a fast render of prepared
    // memory instead of a slow re-summarization. Less coherence loss + faster
    // compaction. Commands: /om:status, /om:view, /om:view full; the `recall`
    // agent tool recovers source evidence by id. Config lives under the
    // `observational-memory` namespace in settings.json. Safe defaults for the
    // compaction trigger are seeded by `settingsDefaults` above (ratio mode,
    // 0.9) so the proactive auto-trigger rarely fires on large-context
    // models; everything else is tuned from /settings → Pi → Observational
    // memory (worker model + thinking, passive mode, worker notices, compaction
    // trigger mode) and persists across installs (fill-only, never reset).
    // https://pi.dev/packages/pi-observational-memory
    "npm:pi-observational-memory": { "tags": ["core"] },

    // Orca Dev integration: Orca hardcodes ~/.pi/agent for its managed pi
    // extensions (it sets ORCA_PI_SOURCE_AGENT_DIR unconditionally), so under
    // ppi profiles they land in the wrong dir and are never loaded (pi only
    // reads PI_CODING_AGENT_DIR, i.e. the active profile). Vendored here so
    // install.sh puts them where pi actually looks. Orca overwrites its own
    // copies in ~/.pi/agent/extensions on integration updates — re-copy those
    // into this repo (`extensions/orca-integration/`, `extensions/herdr/`) and
    // re-run install.sh when Orca bumps them; check HERDR_INTEGRATION_VERSION
    // / the `@orca-managed-pi-extension` header for drift. Core so every
    // profile gets Orca's dashboard status/prefill/title features.
    //   - orca-agent-status.ts: posts session/tool/message lifecycle events
    //     to Orca's local hook server (dashboard status, active tool, last
    //     message preview).
    //   - orca-prefill.ts: pre-fills the editor from ORCA_PI_PREFILL on
    //     startup (Orca "send prompt" suggestions).
    //   - orca-titlebar-spinner.ts: animates the terminal title while the
    //     agent is working.
    //   - herdr/herdr-agent-state.ts: reports working/blocked/idle state to
    //     herdr (Orca's pane orchestration layer) over a unix socket, for
    //     the per-pane status indicator. Installed/versioned by herdr
    //     independently of the orca-* files above (HERDR_INTEGRATION_VERSION).
    // All four are no-ops unless the corresponding ORCA_*/HERDR_* env vars
    // are set, so they're inert outside an Orca-launched terminal.
    "extensions/orca-integration/orca-agent-status.ts": { "tags": ["core"] },
    "extensions/orca-integration/orca-prefill.ts": { "tags": ["core"] },
    "extensions/orca-integration/orca-titlebar-spinner.ts": {
      "tags": ["core"],
    },
    "extensions/herdr/herdr-agent-state.ts": { "tags": ["core"] },

    // address-pr-comments: one-pass workflow to fetch, evaluate, and act on
    // every PR review comment (Copilot/bots + human) — assess each, batch-apply
    // approved fixes, commit (Conventional Commits + Jira scope), reply to and
    // resolve every thread, then report. Now a prompt template — invoke with
    // /address-pr-comments. This skill entry keeps only the hidden
    // troubleshooting companion (TROUBLESHOOTING.md, loaded via `read` on
    // failure); its SKILL.md is a stub. Core so every profile gets it.
    // Ported from impulso-omp's skill of the same name; the OMP `ask` tool
    // calls were adapted to pi's `ask_user_question` schema.
    "skills/address-pr-comments/": { "tags": ["core"] },
    "prompts/address-pr-comments.md": { "tags": ["core"] },

    // pi-development: on-demand instructions for modifying pi or its supported
    // customization surfaces (extensions, skills, themes, TUI, SDK, providers,
    // models, packages, prompts, settings, and keybindings). The custom system
    // prompt emits only a short pointer, while this skill retains the detailed
    // documentation locations, required reading, and topic index. Core so every
    // profile gets it.
    "skills/pi-development/": { "tags": ["core"] },

    // show-me: user-invocation prompt template (/show-me) — explains the
    // current topic visually with concise diagrams, code-shape sketches, and
    // focused HTML artifacts. Vendored from humanlayer/skills' show-me SKILL.md,
    // deliberately NOT a skill: as a prompt template under prompts/ it only ever
    // expands when the user types /show-me — it never enters the system prompt,
    // the <available_skills> block, or mode gating. Core so every profile gets
    // it. Not in /settings (features.ts has no prompt kind): prompt templates in
    // the agent dir aren't toggleable via settings.json — remove the resource
    // entry to uninstall.
    "prompts/show-me.md": { "tags": ["core"] },

    // scout: on-demand pointer skill. Unlike the datadog/glean skills, the
    // scout *subagent* already exists as agents/scout.md (synced above) — this
    // skill exists only so the on-demand-skills keyword trigger ("scout") can
    // inject a hint telling the model to delegate to that subagent. The skill
    // file holds a short pointer; the authoritative contract stays in
    // agents/scout.md. disable-model-invocation: true keeps it out of the
    // always-on <available_skills> block (zero context cost until triggered).
    // Core so every profile gets the hint.
    "skills/scout/": { "tags": ["core"] },

    // pi-provider-litellm (balcsida): LiteLLM proxy native Provider extension.
    // Discovers models from a self-hosted LiteLLM proxy and registers them
    // under pi providers (default provider name `litellm`; aliases possible
    // via `litellm.providers` in settings.json). Supports `/login litellm`
    // (incl. enterprise SSO and Google ADC token auth), LiteLLM MCP tool
    // discovery, and LiteLLM Skills Gateway prompt injection. Core so every
    // profile gets it; configure via `/login litellm` or LITELLM_BASE_URL /
    // LITELLM_API_KEY env vars. https://pi.dev/packages/pi-provider-litellm
    "npm:pi-provider-litellm": { "tags": ["core"] },

    // cache-ttl: prompt-cache TTL control. pi only exposes extended prompt
    // caching via the PI_CACHE_RETENTION env var (no settings.json key); this
    // extension reads <configDir>/cache-ttl.json ({ "retention": "short" |
    // "long" }) at load and sets the env var when "long" is selected —
    // Anthropic ttl:"1h" (vs 5m default), OpenAI prompt_cache_retention:
    // "24h" (vs in-memory), Bedrock CacheTTL.ONE_HOUR. Default is "short"
    // (env untouched; a shell-provided value is preserved/restored). Toggle
    // in /settings → Providers → Prompt caching; /reload applies.
    "extensions/cache-ttl/cache-ttl.ts": { "tags": ["core"] },

    // jira: resolve/find/create/manage Jira tickets via `acli` (with REST
    // fallbacks in FALLBACK.md and a full command reference in REFERENCE.md).
    // jira-authoring: create well-structured tickets under existing epics
    // with AICPE templates — loaded by jira's ticket-creation step. Ported
    // from impulso-omp's mtv-jira / mtv-jira-authoring skills, renamed
    // without the mtv- prefix (not work-exclusive by nature, just tagged
    // work here since Jira/acli are Motive-specific tools).
    "skills/jira/": { "tags": ["work"] },
    "skills/jira-authoring/": { "tags": ["work"] },

    // datadog: fetch metrics and edit dashboards via the `pup` CLI
    // (DataDog's AI-agent-ready CLI — exposes the full Datadog API surface
    // with structured JSON output; auto-detects PI_CODING_AGENT for agent
    // mode). SKILL.md keeps only the dashboards + metrics use cases in
    // context; monitors/logs/events/SLOs/synthetics/APM/reference/
    // troubleshooting are progressive-disclosure files loaded on demand.
    // Auth via `pup auth login` (OAuth2) or DD_API_KEY/DD_APP_KEY env.
    "skills/datadog/": { "tags": ["work"] },
    // glean: search company knowledge, chat with Glean Assistant, look
    // up people, and manage collections/shortcuts/pins/agents via the
    // `glean` CLI (Glean's agent-first CLI — structured JSON output,
    // --dry-run previews, `glean schema` introspection). SKILL.md keeps
    // only search + chat in context; documents/entities/glean-agents/collections/
    // shortcuts/curation/platform/api/reference/troubleshooting are
    // progressive-disclosure files loaded on demand. Auth via
    // `glean auth login` (OAuth/device-code/token auto-detected) or
    // GLEAN_API_TOKEN + GLEAN_SERVER_URL env.
    "skills/glean/": { "tags": ["work"] },
    // create-pr: commit + PR workflow enforcing Motive's commitlint rules
    // (Conventional Commits, uppercase Jira-key scope, 200-char lengths,
    // no-special-chars subject) verified against folder-inference repos'
    // commitlint.config.js, plus branch naming and Jira ticket linkage via
    // the jira skill. Now a prompt template (prompts/create-pr.md, below) —
    // invoke with /create-pr. This skill entry keeps only the hidden
    // troubleshooting companion (TROUBLESHOOTING.md, loaded via `read` on
    // failure); its SKILL.md is a stub. Ported from impulso-omp's
    // mtv-commit-and-pr skill, renamed to drop the mtv- prefix.
    "skills/create-pr/": { "tags": ["work"] },
    "prompts/create-pr.md": { "tags": ["work"] },
    // commit: make a single commitlint-compliant commit on Motive repos.
    // Model-invocable (no disable-model-invocation) so it shows up in
    // <available_skills> and the agent loads it on its own whenever it runs
    // `git commit` — including follow-up commits on an existing PR, CI fixes,
    // and iteration, which never re-enter the one-shot create-pr flow. Targets
    // the two recurring failure modes: wrong/missing type or Jira scope, and
    // special chars in the subject (commitlint no-special-chars-in-subject).
    // create-pr and address-pr-comments defer to these same rules for their
    // commit steps.
    "skills/commit/": { "tags": ["work"] },
    // gws-docs-authoring: author/evolve long-form Google Docs via the gws
    // CLI on top of the vendored gws-docs / gws-shared skills (from the
    // extensions/gws/ extension). Two hard-won rules: edit docs in place
    // (never delete/recreate — keeps the documentId/URL stable), and insert
    // PNG images from Drive manually when org policy blocks public sharing
    // (the Docs API's insertInlineImage needs a publicly fetchable URL).
    // Use for Docs one-pagers, TDDs, design docs built programmatically.
    "skills/gws-docs-authoring/": { "tags": ["work"] },
    // create-pr-personal: lightweight commit + PR workflow for personal
    // repos. Same shape as create-pr but stripped down — Conventional
    // Commits for the message + PR title, a short what/why PR body, no Jira,
    // no strict commitlint, no enforced branch naming beyond "get off the
    // protected branch". Now a prompt template — invoke with
    // /create-pr-personal.
    "prompts/create-pr-personal.md": { "tags": ["personal"] },
    // border-on-user-messages: draws a `┌─ You ─┐` / `│ … │` / `└───┘`
    // box around every user message in the TUI transcript so your own
    // messages are easy to spot amid assistant/tool output. Patches
    // UserMessageComponent.prototype.render at session_start (same
    // mechanism pi-droid-styling used for its user-prefix/core-message
    // blocks). TUI-only; toggleable from /impulso. Core so every profile
    // gets it.
    "extensions/borderonusermessages/borderonusermessages.ts": {
      "tags": ["core"],
      "dest": "extensions/borderonusermessages/index.ts",
    },
    // border-on-tool-calls: draws a `┌─ <toolName> ─┐` / `│ … │` /
    // `└──────┘` box around every tool call in the TUI transcript so each
    // tool invocation reads as a discrete framed block labeled with its
    // name. Patches ToolExecutionComponent.prototype.render at
    // session_start (same mechanism as border-on-user-messages). TUI-only;
    // toggleable from /impulso. Core so every profile gets it.
    "extensions/borderontoolcalls/borderontoolcalls.ts": {
      "tags": ["core"],
      "dest": "extensions/borderontoolcalls/index.ts",
    },
    // pi-btw (narumitw): ask side questions in a separate side thread without
    // derailing the main Pi conversation/coding task. `/btw <question>` starts a
    // fresh side thread immediately; `/btw` opens a manager (start from main
    // thread tree, resume, settings). Side Q&A stays out of the main transcript
    // unless you explicitly `Ctrl+R` bring selected context back to the editor.
    // Uses the current session model+thinking level, or an independent choice
    // stored in <configDir>/pi-btw.json. Core so every profile gets it.
    // https://www.npmjs.com/package/@narumitw/pi-btw
    "npm:@narumitw/pi-btw": { "tags": ["core"] },

    // Future tagged resources, e.g.:
    // "skills/home-lab/": { "tags": ["personal"] },
  },
  // Standalone global CLI tools (NOT pi resources). These are regular npm
  // packages that live in this repo and are installed globally (npm i -g) by
  // ./install.sh, separate from the profile resource sync above. They are not
  // synced into any profile dir and are not loaded by pi. `path` is relative
  // to the repo root; `bin` is informational (read from package.json).
  "tools": {
    "pi-omp-stats": { "path": "packages/pi-omp-stats" },
  },
}
